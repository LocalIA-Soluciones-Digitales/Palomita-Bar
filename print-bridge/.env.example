# Copia este archivo a ".env" y rellena los valores reales.
# NUNCA subas el ".env" real a git (ya está ignorado).

# Mismos valores que usa la web (Palomita-Bar/.env.local):
#   SUPABASE_URL    = NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_ANON_KEY = NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_URL=https://ukhfaphloxlszomccgde.supabase.co/rest/v1/
SUPABASE_ANON_KEY=

# Cuenta de acceso a /admin dedicada a este servicio (crear una nueva,
# distinta de las personales, desde Supabase Auth o el alta de usuarios
# de negocio). Solo necesita permiso de staff/admin de Palomita.
BRIDGE_EMAIL=cocina-impresora@palomitabar.local
BRIDGE_PASSWORD=

# Impresora de COCINA (JASSWAY JAW-260H en red, IP fija, puerto crudo 9100):
PRINTER_COCINA_INTERFACE=tcp://192.168.1.129:9100

# Impresora de BARRA: va por USB directo al PC de la TPV (driver genérico
# tipo "PrinterPOS-80"). No se usa el nombre de la impresora de Windows,
# sino el nombre del PUERTO tal como aparece en
# Propiedades de la impresora > Puertos (ej. "USB001"):
PRINTER_BARRA_PUERTO_WINDOWS=USB001
